{
  "format": "sim-bench-score-rules-v1",
  "maximum_points": 50,
  "tasks": [
    {"id": 1, "maximum_points": 30, "observations": {"performance": 15, "accuracy": 10, "memory": 5}, "scenes": ["1-1", "1-2", "1-3", "1-5", "1-6", "1-7"]},
    {"id": 2, "maximum_points": 10, "observations": {"performance": 5, "accuracy": 3, "memory": 2}, "scenes": ["1-4", "1-8"], "minimum_effective_dof": 100000, "physics_frames": 500, "substeps": {"1-4": 5, "1-8": 4}},
    {"id": 3, "maximum_points": 10, "observations": {"performance": 5, "accuracy": 3, "memory": 2}, "scenes": ["1-9", "1-10", "1-11"]}
  ],
  "performance": {
    "fps": "sum(frames) / sum(seconds)",
    "ratio": "candidate_fps / reference_fps",
    "repetitions": 3,
    "score_below_or_at_one": "80 * ratio",
    "score_above_one": "80 + 20 * (ratio - 1) / (H - 1)",
    "H": "maximum_ratio_of_the_two_teams_in_the_same_scene",
    "coupled_candidate_fps": "(version_1_aggregate_fps + version_2_aggregate_fps) / 2",
    "tgv_reference_fps": 30
  },
  "memory": {
    "mean_peak": "sum(three_process_peaks) / 3",
    "ratio": "candidate_memory_occupancy / reference_memory_occupancy",
    "coupled_candidate_mean_peak": "(version_1_mean_peak + version_2_mean_peak) / 2",
    "tgv_reference_peak_bytes": 6442450944
  },
  "curves": {
    "trajectory": [[0.01, 100], [0.1, 80], [0.5, 0]],
    "conservation": [[0.95, 100], [1.05, 80], [1.2, 0]],
    "memory": [[0.8, 100], [2.0, 0]],
    "tgv": [[0.03, 100], [0.4, 0]]
  },
  "conservation": {
    "fields": ["R_P_max", "R_E_max", "mean_penetration_over_length", "negative_normal_peak_over_force"],
    "exclude_reference_abs_at_most": 0.001,
    "component_weights": "equal",
    "qualification_ratio_at_most": 1.05
  },
  "coupled": {
    "accuracy_repetitions": 1,
    "temporal_error_reduction": "maximum",
    "pressure_error": "max_frame(sum_grid(abs(pressure_A - pressure_N)) / sum_grid(abs(pressure_N)))",
    "dry_cell_pressure": 0,
    "cube_state_error": "max_frame(norm(center_A - center_N) / norm(center_N - initial_center))",
    "volume_loss_error": "max_frame(max(0, 1 - candidate_CIC_volume / candidate_initial_CIC_volume))",
    "zero_reference_equal_error": 0,
    "zero_reference_unequal_error": "missing",
    "components": {
      "pressure_error": {"version": 1, "weight": 0.25, "full_score_error": 0.05},
      "cube_state_error": {"version": 1, "weight": 0.25, "full_score_error": 0.05},
      "volume_loss_error": {"version": 2, "weight": 0.5, "full_score_error": 0.1}
    },
    "component_score": "max(0, min(100, 100 * (1 - error) / (1 - full_score_error)))"
  },
  "aggregation": {
    "accuracy_repetitions": 1,
    "accuracy_repetitions_by_scene": {"1-4": 3, "1-8": 3},
    "large_scene_accuracy": "ratio_of_candidate_and_reference_mean_full_trajectory_metrics",
    "scene_points": "sum(observation_points * score / 100)",
    "task_points": "mean(scene_points)",
    "total_points": "sum(task_points)",
    "missing_observation_score": 0,
    "failed_observation_score": 0,
    "round_intermediate_values": false,
    "display_decimal_places": 2,
    "display_rounding": "half_up"
  }
}
